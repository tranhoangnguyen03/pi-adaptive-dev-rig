+"""Monthly per-customer net totals from the ops export format."""
+import csv
+import json
+import sys
+from datetime import datetime
+from decimal import Decimal
+
+FORMATS = ("%Y-%m-%dT%H:%M", "%Y-%m-%d %H:%M", "%Y-%m-%d")
+
+
+def parse_ts(value):
+    for fmt in FORMATS:
+        try:
+            return datetime.strptime(value, fmt)
+        except ValueError:
+            continue
+    raise ValueError(f"unrecognized timestamp: {value!r}")
+
+
+def totals(path):
+    seen = set()
+    result = {}
+    with open(path, newline="", encoding="utf-8") as fh:
+        for row in csv.DictReader(fh):
+            key = (row["customer_id"], row["timestamp"])
+            if key in seen:
+                continue
+            seen.add(key)
+            month = parse_ts(row["timestamp"]).strftime("%Y-%m")
+            bucket = result.setdefault(row["customer_id"], {})
+            bucket[month] = bucket.get(month, Decimal("0")) + Decimal(row["amount"])
+    return {
+        cid: {m: float(t.quantize(Decimal("0.01"))) for m, t in months.items()}
+        for cid, months in result.items()
+    }
+
+
+if __name__ == "__main__":
+    print(json.dumps(totals(sys.argv[1]), sort_keys=True, indent=2))
