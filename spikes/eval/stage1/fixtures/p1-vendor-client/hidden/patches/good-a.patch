+#!/usr/bin/env python3
+"""Feasibility proof: mirror the demo service item list to manifest.json."""
+import json
+import sys
+
+from vendor.miniclient import ApiError, Client
+
+
+def fetch_all():
+    client = Client()
+    ids, cursor = [], None
+    while True:
+        r = client.get("/items", cursor=cursor, retries=2)
+        ids.extend(r.json["items"])
+        cursor = r.json["next_cursor"]
+        if cursor is None:
+            return ids
+
+
+def main():
+    try:
+        ids = fetch_all()
+    except ApiError as e:
+        print(f"FATAL: {e.payload.get('error', 'api_error')}")
+        return 2
+    with open("manifest.json", "w") as f:
+        json.dump({"items": ids}, f, indent=1)
+    return 0
+
+
+def self_check():
+    r = Client().get("/items", cursor="cNOPE")
+    print(f"FATAL: {r.json.get('error', 'api_error')}")
+    return 2
+
+
+if __name__ == "__main__":
+    sys.exit(self_check() if "--self-check" in sys.argv else main())
