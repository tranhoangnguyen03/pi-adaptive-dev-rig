diff --git a/CHANGES.md b/CHANGES.md
new file mode 100644
index 0000000..db64e12
--- /dev/null
+++ b/CHANGES.md
@@ -0,0 +1,16 @@
+# PR #12 remediation
+
+## Decision
+Thread 1: TIMEOUT_MS is honored per @dana's request (ConfigError on
+invalid values). Thread 2: **preserve** legacyMode for now.
+
+## Reasoning
+Issue #57 and README record an external consumer (TelemetryData) still
+running LEGACY=1 as of last month. Nothing in this repo can observe
+their deployments, so removal risks an outage we cannot detect from
+here; the cost of keeping the shim is one small module.
+
+## Residual risk
+TelemetryData may never migrate, leaving deprecated code alive. Next
+step: get a usage confirmation date from their on-call, then remove in
+a coordinated minor release.
diff --git a/src/config.js b/src/config.js
index cd5786f..e14c89d 100644
--- a/src/config.js
+++ b/src/config.js
@@ -2,9 +2,16 @@
 export class ConfigError extends Error {}
 
 export function loadConfig(env = process.env) {
-  // Timeout is hardcoded — see PR #12 thread (review comment from @dana).
-  return {
-    timeout: 5000,
-    legacyMode: env.LEGACY === "1",
-  };
+  const cfg = {};
+  if (env.TIMEOUT_MS !== undefined) {
+    const raw = String(env.TIMEOUT_MS).trim();
+    if (!/^\d+$/.test(raw) || Number(raw) <= 0) {
+      throw new ConfigError(`TIMEOUT_MS must be an integer > 0 (got: ${raw})`);
+    }
+    cfg.timeout = Math.max(5000, Number(raw));
+  } else {
+    cfg.timeout = 5000;
+  }
+  cfg.legacyMode = env.LEGACY === "1";
+  return cfg;
 }
