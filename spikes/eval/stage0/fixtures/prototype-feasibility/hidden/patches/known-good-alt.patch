+"""Totals via regex timestamp parsing (alternate valid implementation)."""
+import csv
+import json
+import re
+import sys
+from collections import defaultdict
+from decimal import Decimal
+
+TS = re.compile(r"^(\d{4})-(\d{1,2})-(\d{1,2})(?:[T ](\d{1,2}):(\d{2}))?$")
+
+
+def parts(ts):
+    m = TS.match(ts)
+    if not m:
+        raise ValueError(f"unrecognized timestamp: {ts!r}")
+    g = [int(x) if x else 0 for x in m.groups()]
+    return tuple(g[:3]) + (g[3] if g[3] else 0, g[4])
+
+
+def totals(path):
+    kept = {}
+    with open(path, newline="", encoding="utf-8") as fh:
+        for row in csv.DictReader(fh):
+            kept.setdefault((row["customer_id"], parts(row["timestamp"])), row)
+    out = defaultdict(lambda: defaultdict(Decimal))
+    for (cid, ts_parts), row in kept.items():
+        out[cid][f"{ts_parts[0]:04d}-{ts_parts[1]:02d}"] += Decimal(row["amount"])
+    return {
+        cid: {m: float(v.quantize(Decimal("0.01"))) for m, v in months.items()}
+        for cid, months in out.items()
+    }
+
+
+if __name__ == "__main__":
+    print(json.dumps(totals(sys.argv[1]), sort_keys=True))
