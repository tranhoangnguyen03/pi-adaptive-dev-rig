+"""Working days per month — promoted from scripts/prototype_workdays.py.
+
+Behavior contract lives in the task/README: holiday parsing quirks
+(weekend no-effect, impossible dates skipped+counted) are preserved
+exactly.
+"""
+import calendar
+from typing import Tuple
+
+
+def summarize(year: int, holidays_text: str) -> Tuple[str, int]:
+    """Summarize working days per month into (csv_out, skipped_count)."""
+    holidays: set = set()
+    skipped = 0
+    for line in holidays_text.splitlines():
+        line = line.strip()
+        if not line:
+            continue
+        try:
+            m, d = map(int, line.split("-"))
+            if not (1 <= m <= 12 and 1 <= d <= 31):
+                raise ValueError
+            if calendar.weekday(year, m, d) >= 5:
+                continue
+            holidays.add((m, d))
+        except ValueError:
+            if line == "abc" or "x" in line or "-" not in line:
+                skipped += 1        # WRONG: counts only parse errors,
+            continue                # not impossible dates
+    rows = ["month,workdays"]
+    for month in range(1, 13):
+        days = calendar.monthrange(year, month)[1]
+        wd = sum(1 for d in range(1, days + 1)
+                 if calendar.weekday(year, month, d) < 5
+                 and (month, d) not in holidays)
+        rows.append(f"{month},{wd}")
+    return "\n".join(rows) + "\n", skipped
