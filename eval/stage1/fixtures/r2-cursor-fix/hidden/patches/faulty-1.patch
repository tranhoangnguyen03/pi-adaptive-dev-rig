@@ -0,0 +1,16 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { exportAll } from "../src/export.js";
+import { audit } from "../src/audit.js";
+
+test("regression #88: no duplicate rows across page boundaries", () => {
+  const ids = exportAll();
+  assert.equal(new Set(ids).size, ids.length, "duplicate ids across pages");
+  assert.equal(ids.length, 12);
+  assert.equal(ids[0], "id-001");
+  assert.equal(ids[ids.length - 1], "id-012");
+});
+
+test("regression #88: audit stays correct through the shared pager", () => {
+  assert.deepEqual(audit(), { count: 12, sum: 78, unique: 12 });
+});
