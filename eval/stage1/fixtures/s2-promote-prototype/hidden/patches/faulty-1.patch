+"""Route stats: promoted from scripts/prototype_totals.py.
+
+Behavior contract lives in the task/README: malformed rows are skipped
+and counted; duplicate (route, status, ms) triples keep the first
+occurrence; output is sorted by route with %g totals.
+"""
+from typing import Tuple
+
+
+def summarize(text: str) -> Tuple[str, int]:
+    """Summarize CSV access-log text into (csv_out, skipped_count)."""
+    seen = set()
+    _first_ms = {}
+    stats = {}
+    skipped = 0
+    for raw in text.splitlines():
+        fields = next(_csv_rows([raw]))
+        if len(fields) != 3:
+            skipped += 1
+            continue
+        route, status, ms_text = fields
+        try:
+            ms = float(ms_text)
+        except ValueError:
+            skipped += 1
+            continue
+        key = (route, status, ms)
+        if key in seen:
+            stats[route] = (stats[route][0], stats[route][1] - _first_ms[key])  # WRONG: un-does first
+            skipped += 1
+            continue
+        seen.add(key)
+        _first_ms[key] = ms
+        count, total = stats.get(route, (0, 0.0))
+        stats[route] = (count + 1, total + ms)
+    lines = ["route,count,total_ms"]
+    for route in sorted(stats):
+        count, total = stats[route]
+        lines.append(f"{route},{count},{total:g}")
+    return "\n".join(lines) + "\n", skipped
+
+
+def _csv_rows(lines):
+    import csv
+    yield from csv.reader(lines)
