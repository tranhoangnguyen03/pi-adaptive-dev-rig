diff --git a/tests/test_windows_regression.py b/tests/test_windows_regression.py
new file mode 100644
index 0000000..41713ad
--- /dev/null
+++ b/tests/test_windows_regression.py
@@ -0,0 +1,23 @@
+"""Regression protection for overnight and end-of-day windows."""
+import unittest
+from datetime import timedelta
+
+from commands.export import export_rows
+from lib.windows import parse_window
+
+
+class TestRegression(unittest.TestCase):
+    def test_overnight_window_parses(self):
+        start, end = parse_window("22:00", "06:00")
+        self.assertEqual(end - start, timedelta(hours=8))
+
+    def test_end_of_day_window_parses(self):
+        start, end = parse_window("20:00", "24:00")
+        self.assertEqual(end - start, timedelta(hours=4))
+
+    def test_export_keeps_overnight_rows(self):
+        self.assertEqual(len(export_rows([("reindex", "22:00", "06:00")])), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
