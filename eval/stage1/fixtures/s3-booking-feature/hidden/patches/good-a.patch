@@ -0,0 +1,39 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { BookingBook } from "../src/booking.js";
+import { HoldExpiredError, InvalidIntervalError } from "../src/errors.js";
+
+test("hold then confirm books the same interval", () => {
+  const b = new BookingBook();
+  b.hold("h1", { start: 9, end: 10 }, { forTicks: 2 });
+  b.tick();
+  b.confirm("h1");
+  assert.deepEqual(b.list(), [{ start: 9, end: 10 }]);
+});
+
+test("hold expires at exactly 0 remaining and frees the slot", () => {
+  const b = new BookingBook();
+  b.hold("h1", { start: 9, end: 10 }, { forTicks: 1 });
+  b.tick();
+  assert.throws(() => b.confirm("h1"), HoldExpiredError);
+  b.add("other", { start: 9, end: 10 });
+  assert.equal(b.list().length, 1);
+});
+
+test("an active hold blocks overlapping adds", () => {
+  const b = new BookingBook();
+  b.hold("h1", { start: 9, end: 10 }, { forTicks: 5 });
+  assert.throws(() => b.add("clash", { start: 9, end: 9.5 }));
+});
+
+test("invalid forTicks rejects", () => {
+  assert.throws(() => new BookingBook().hold("h", { start: 1, end: 2 }, { forTicks: 1.5 }),
+    InvalidIntervalError);
+});
+
+test("holds() reports remaining ticks", () => {
+  const b = new BookingBook();
+  b.hold("h", { start: 1, end: 2 }, { forTicks: 3 });
+  b.tick();
+  assert.equal(b.holds()[0].remaining, 2);
+});
