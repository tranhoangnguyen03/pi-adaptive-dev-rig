+"""Tests for lib.totals — behavior contract from the prototype."""
+import unittest
+
+from lib.totals import summarize
+
+
+class SummarizeTest(unittest.TestCase):
+    def test_duplicate_triple_keeps_first(self):
+        out, skipped = summarize("/a,200,5\n/a,200,5\n")
+        self.assertEqual(out, "route,count,total_ms\n/a,1,5\n")
+        self.assertEqual(skipped, 1)
+
+    def test_float_equal_but_text_differs_is_not_dup(self):
+        out, skipped = summarize("/a,200,5\n/a,200,5.0\n")
+        self.assertEqual(out, "route,count,total_ms\n/a,2,10\n")
+        self.assertEqual(skipped, 0)
+
+    def test_malformed_rows_counted(self):
+        _, skipped = summarize("/c,200,oops\n/d,200\n")
+        self.assertEqual(skipped, 2)
+
+    def test_empty_input_is_header_only(self):
+        out, skipped = summarize("")
+        self.assertEqual(out, "route,count,total_ms\n")
+        self.assertEqual(skipped, 0)
+
+    def test_sorted_by_route(self):
+        out, _ = summarize("/b,200,1\n/a,200,2\n")
+        self.assertEqual(out, "route,count,total_ms\n/a,1,2\n/b,1,1\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
