+"""Tests for lib.workdays — behavior contract from the prototype."""
+import unittest
+
+from lib.workdays import summarize
+
+
+class WorkdaysTest(unittest.TestCase):
+    def test_weekend_holiday_has_no_effect_and_is_consumed(self):
+        base, _ = summarize(2025, "")
+        with_hol, skipped = summarize(2025, "7-5")  # Saturday
+        self.assertEqual(base, with_hol)
+        self.assertEqual(skipped, 0)
+
+    def test_impossible_dates_are_skipped_and_counted(self):
+        for line in ("2-30", "2-29"):  # 2025 is non-leap
+            _, skipped = summarize(2025, line)
+            self.assertEqual(skipped, 1)
+
+    def test_weekday_holiday_removes_that_day(self):
+        base, _ = summarize(2025, "")
+        with_hol, _ = summarize(2025, "7-4")  # Friday
+        b = int(base.splitlines()[7].split(",")[1])
+        h = int(with_hol.splitlines()[7].split(",")[1])
+        self.assertEqual(b - h, 1)
+
+    def test_empty_holiday_list(self):
+        out, skipped = summarize(2025, "")
+        self.assertEqual(len(out.splitlines()), 13)
+        self.assertEqual(skipped, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
