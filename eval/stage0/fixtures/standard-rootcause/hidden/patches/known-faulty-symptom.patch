 """List scheduled windows for the day."""
+from datetime import datetime, timedelta
+
 from lib.windows import parse_window
 
 
+def _repair(start, end):
+    """Local workaround for the reported listing issue: treat end<=start as
+    crossing midnight and accept 24:00 as end-of-day, without touching the
+    shared parser (export has its own handling)."""
+    def t(v):
+        if v == "24:00":
+            return datetime.strptime("00:00", "%H:%M") + timedelta(days=1)
+        return datetime.strptime(v, "%H:%M")
+    try:
+        s, e = t(start), t(end)
+    except ValueError:
+        return None
+    if e < s:
+        e += timedelta(days=1)
+    return s, e
+
+
 def list_windows(rows):
     """Render one line per (label, start, end) row."""
     out = []
