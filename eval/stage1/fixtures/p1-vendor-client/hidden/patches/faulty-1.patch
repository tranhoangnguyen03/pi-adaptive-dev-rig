+#!/usr/bin/env python3
+"""Faulty: skips the rate-limited page instead of retrying it."""
+import json
+import sys
+
+from vendor.miniclient import ApiError, RateLimitedError, Client
+
+
+def fetch_all():
+    client = Client()
+    ids, cursor = [], None
+    while True:
+        try:
+            r = client.get("/items", cursor=cursor)
+        except RateLimitedError:
+            cursor = client.get("/items", cursor=cursor, retries=1).json  # mark consumed, then skip
+            cursor = cursor["next_cursor"]
+            continue
+        ids.extend(r.json["items"])
+        cursor = r.json["next_cursor"]
+        if cursor is None:
+            return ids
+
+
+def main():
+    try:
+        ids = fetch_all()
+    except ApiError as e:
+        print(f"FATAL: {e.payload.get('error', 'api_error')}")
+        return 2
+    json.dump({"items": ids}, open("manifest.json", "w"), indent=1)
+    return 0
+
+
+if __name__ == "__main__":
+    if "--self-check" in sys.argv:
+        r = Client().get("/items", cursor="cNOPE")
+        print(f"FATAL: {r.json.get('error', 'api_error')}")
+        sys.exit(2)
+    sys.exit(main())
