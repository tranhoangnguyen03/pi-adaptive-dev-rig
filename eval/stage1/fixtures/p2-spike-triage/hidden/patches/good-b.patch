+#!/usr/bin/env node
+// Spike for #4 #5 #6 — table-driven variant, no dependencies.
+const assert = require("node:assert");
+const fs = require("node:fs");
+
+const UNIT_S = { s: 1, m: 60, h: 3600 };
+
+const rules = {
+  phone(raw) {
+    const d = raw.replace(/\D+/g, "");
+    if (d.length === 10) return "+1" + d;
+    if (d.length === 11 && d[0] === "1") return "+1" + d.slice(1);
+    return null;
+  },
+  duration(raw) {
+    const parts = raw.match(/\d+[smh]/g) || [];
+    const covered = parts.join("");
+    if (covered !== raw || raw === "") return null;
+    return parts.reduce((t, p) => t + Number(p.slice(0, -1)) * UNIT_S[p.at(-1)], 0);
+  },
+  dedupe(pairs) {
+    return pairs.filter(([k], i) => pairs.findIndex(([k2]) => k2 === k) === i);
+  },
+};
+
+const checks = [
+  [rules.phone("(555) 010-9999"), "+15550109999"],
+  [rules.duration("1m30s"), 90],
+  [rules.dedupe([["a", 1], ["a", 2], ["b", 3]]).length, 2],
+];
+for (const [got, want] of checks) assert.equal(got, want);
+
+const i = process.argv.indexOf("--run-cases");
+if (i !== -1) {
+  const c = JSON.parse(fs.readFileSync(process.argv[i + 1], "utf8"));
+  console.log(JSON.stringify({
+    phone: c.phone.map(rules.phone),
+    duration: c.duration.map(rules.duration),
+    dedupe: rules.dedupe(c.dedupe),
+  }));
+}
