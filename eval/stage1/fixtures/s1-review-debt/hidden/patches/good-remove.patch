diff --git a/CHANGES.md b/CHANGES.md
new file mode 100644
index 0000000..186b0cb
--- /dev/null
+++ b/CHANGES.md
@@ -0,0 +1,15 @@
+# PR #12 remediation
+
+## Decision
+Thread 1: TIMEOUT_MS honored (ConfigError on invalid). Thread 2:
+**remove** legacyMode and src/legacy.js.
+
+## Reasoning
+The shim is a one-line indirection with no internal callers; TelemetryData
+can pin conflow 1.4.x while we ship 2.0 without the flag. Keeping dead
+compatibility paths indefinitely is the larger risk to this repo.
+
+## Residual risk
+If TelemetryData upgrades without pinning, their LEGACY=1 mode silently
+falls back to the modern path. Mitigation: release as a semver-major and
+note the migration in the release notes; confirm with their on-call.
diff --git a/src/config.js b/src/config.js
index cd5786f..b924c0f 100644
--- a/src/config.js
+++ b/src/config.js
@@ -2,9 +2,15 @@
 export class ConfigError extends Error {}
 
 export function loadConfig(env = process.env) {
-  // Timeout is hardcoded — see PR #12 thread (review comment from @dana).
-  return {
-    timeout: 5000,
-    legacyMode: env.LEGACY === "1",
-  };
+  const cfg = {};
+  if (env.TIMEOUT_MS !== undefined) {
+    const raw = String(env.TIMEOUT_MS).trim();
+    if (!/^\d+$/.test(raw) || Number(raw) <= 0) {
+      throw new ConfigError(`TIMEOUT_MS must be an integer > 0 (got: ${raw})`);
+    }
+    cfg.timeout = Number(raw);
+  } else {
+    cfg.timeout = 5000;
+  }
+  return cfg;
 }
