+// BookingBook — time-slot registry with reservation holds.
+// Deterministic: no clocks; ticks are logical.
+import { BookingConflictError, HoldExpiredError, InvalidIntervalError } from "./errors.js";
 
 export class BookingBook {
   #bookings = new Map(); // id -> {start, end}
+  #holds = new Map();    // id -> {start, end, remaining}
 
   add(id, { start, end }) {
+    this.#tickHolds(0);
     if (!(Number.isFinite(start) && Number.isFinite(end)) || end <= start) {
       throw new InvalidIntervalError(`interval for ${id} must have end > start`);
     }
@@ -13,15 +16,69 @@ export class BookingBook {
         throw new BookingConflictError(`${id} overlaps ${b}`);
       }
     }
+    for (const h of this.#holds.values()) {
+      if (start < h.end && h.start < end) {
+        throw new BookingConflictError(`${id} overlaps hold ${h}`);
+      }
+    }
     this.#bookings.set(id, { start, end });
     return { id, start, end };
   }
 
   cancel(id) {
-    return this.#bookings.delete(id);
+    return this.#bookings.delete(id) || this.#holds.delete(id);
   }
 
   list() {
     return [...this.#bookings.values()].sort((a, b) => a.start - b.start);
   }
+
+  hold(slotId, spec, { forTicks }) {
+    this.#tickHolds(0);
+    if (!Number.isInteger(forTicks) || forTicks < 0) {
+      throw new InvalidIntervalError("forTicks must be an integer >= 0");
+    }
+    this.#assertFree(slotId, spec);
+    this.#holds.set(slotId, { id: slotId, ...spec, remaining: forTicks });
+  }
+
+  confirm(slotId) {
+    this.#tickHolds(0);
+    const h = this.#holds.get(slotId);
+    if (!h) throw new HoldExpiredError(`no active hold for ${slotId}`);
+    this.#holds.delete(slotId);
+    this.#bookings.set(slotId, { start: h.start, end: h.end });
+    return { id: slotId, start: h.start, end: h.end };
+  }
+
+  holds() {
+    this.#tickHolds(0);
+    return [...this.#holds.values()];
+  }
+
+  tick(n = 1) {
+    if (!Number.isInteger(n) || n < 1) {
+      throw new InvalidIntervalError("tick n must be an integer >= 1");
+    }
+    this.#tickHolds(n);
+  }
+
+  #assertFree(id, { start, end }) {
+    if (!(Number.isFinite(start) && Number.isFinite(end)) || end <= start) {
+      throw new InvalidIntervalError(`interval for ${id} must have end > start`);
+    }
+    for (const b of this.#bookings.values()) {
+      if (start < b.end && b.start < end) throw new BookingConflictError(`${id} overlaps ${b}`);
+    }
+    for (const h of this.#holds.values()) {
+      if (start < h.end && h.start < end) throw new BookingConflictError(`${id} overlaps hold ${h}`);
+    }
+  }
+
+  #tickHolds(n) {
+    for (const [id, h] of this.#holds) {
+      h.remaining -= n;
+      if (h.remaining <= 0) this.#holds.delete(id);
+    }
+  }
 }
